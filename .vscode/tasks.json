{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend (FastAPI)",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -X utf8 -m uvicorn main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "servers",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Start Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev -- --host 127.0.0.1 --strictPort",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "servers",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Start All (Background Process)",
      "type": "shell",
      "command": "powershell.exe -ExecutionPolicy Bypass -File .\\start_all.ps1",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    }
  ]
}
